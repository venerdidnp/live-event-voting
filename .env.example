# =============================================================================
# Live Event Voting System - Environment Variables Example
# Copy this file to .env.local for local development.
# =============================================================================

# Neon PostgreSQL connection string (Serverless pooled connection recommended)
DATABASE_URL="postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Admin Authentication Password
ADMIN_PASSWORD="super-secret-admin-password"

# Admin Session Signing Secret (HMAC SHA-256, minimum 32 random characters)
ADMIN_SESSION_SECRET="replace-with-a-very-long-random-secret-key-32-chars-min"

# Salt used to hash voter IP addresses with SHA-256 for privacy-preserving rate limiting
IP_HASH_SALT="replace-with-a-random-salt-string"

# Public App Base URL (used for QR code on projector display)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

# Application Name displayed in browser title and meta tags
NEXT_PUBLIC_APP_NAME="StageVote"
